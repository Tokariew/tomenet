#!/bin/sh
# shellcheck disable=SC2164

tomefolder=/media/btrfsv2/containers/data/tomenet

today=$(date --iso-8601)

podman run --rm -v "$tomefolder:/srv/build":z --network lab registry.tokariew.xyz:5000/tomenet:latest -t iddcmove.patch
[ ! -e "$tomefolder/tomenet-$today.7z" ] && exit 0
cd "$tomefolder" || exit 1
sha256sum  "tomenet-$today.7z" > "tomenet-$today.7z.sha256sum"
cd ~
rclone copy "$tomefolder/tomenet-$today.7z" dav:tomenet/weekly-snapshots
rclone copy "$tomefolder/tomenet-$today.7z.sha256sum" dav:tomenet/weekly-snapshots
rm "$tomefolder/tomenet-$today.7z"
rm "$tomefolder/tomenet-$today.7z.sha256sum"
echo syncing
rclone sync dav:tomenet/ drop:TomeNET
rclone sync dav:tomenet/ mega:TomeNET
